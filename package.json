    "@oh-my-pi/pi-coding-agent": { "optional": true },
    "@oh-my-pi/pi-natives": { "optional": true }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.8.7",
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "@oh-my-pi/pi-natives": "18.8.7",
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
